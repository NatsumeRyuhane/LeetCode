{
  "name": "leetcode-coach-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Read-only HUD over a leetcode-coach practice repo (db/*.jsonl, sessions/, NOTES.md, TAGS.md).",
  "scripts": {
    "dev": "vite",
    "demo": "COACH_DEMO=1 vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "fixture": "node scripts/make-demo-fixture.mjs",
    "check-parity": "node scripts/check-parity.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
